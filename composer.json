{
    "name": "medzuch/jwt-bundle",
    "description": "Symfony bundle wiring medzuch/jwt-php into Symfony Security: issue and verify RFC 9068 access tokens, OIDC ID tokens and custom JWS/JWE. PHP 8.3 and 8.4, Symfony 6.4, 7.4 and 8.x.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "symfony-bundle", "jwt", "jose", "security", "auth", "rfc9068", "oidc"],
    "authors": [
        {
            "name": "Marcin Mech",
            "email": "marcin.mech@gmail.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0",
        "medzuch/jwt-php": "^1.2",
        "psr/clock": "^1.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "roave/security-advisories": "dev-latest",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Medzuch\\JwtBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medzuch\\JwtBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "phpstan": "Run static analysis at level 9",
        "cs:check": "Check code style without fixing",
        "cs:fix": "Apply code-style fixes",
        "qa": "Fast quality gate (style + phpstan + tests)"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
