{
    "name": "medzuch/jwt-bundle",
    "description": "Symfony bundle wiring medzuch/jwt-php into Symfony Security: issue and verify RFC 9068 access tokens, OIDC ID tokens and custom JWS/JWE. PHP 8.3 and 8.4, Symfony 6.4, 7.4 and 8.x.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "jwt",
        "jose",
        "security",
        "auth",
        "rfc9068",
        "oidc"
    ],
    "authors": [
        {
            "name": "Marcin Mech",
            "email": "marcin.mech@gmail.com"
        }
    ],
    "require": {
        "medzuch/jwt-php": "^1.2",
        "php": "~8.3.0 || ~8.4.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/cache": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/error-handler": "^6.4 || ^7.4 || ^8.0",
        "symfony/expression-language": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "suggest": {
        "psr/http-client": "To consume a remote JWK Set: any PSR-18 client, Symfony's psr18.http_client included",
        "psr/http-factory": "To point a remote JWK Set at a PSR-17 request factory, when the PSR-18 client is not one itself",
        "psr/simple-cache": "To cache a remote JWK Set through a PSR-16 service of your own",
        "symfony/cache": "To cache a remote JWK Set through a PSR-6 pool such as cache.app, which the default wiring wraps",
        "symfony/console": "To run jwt:key:generate, jwt:token:create, jwt:token:inspect, jwt:jwks:dump and jwt:config:check",
        "phpunit/phpunit": "To use Medzuch\\JwtBundle\\Test\\AssertsBearerChallenges in your own functional suite; TestTokenFactory needs nothing beyond medzuch/jwt-php",
        "symfony/expression-language": "To write is_granted_scope() in access_control or #[IsGranted] expressions",
        "symfony/web-profiler-bundle": "To see the JWT panel, which says why a token was refused where the response will not"
    },
    "autoload": {
        "psr-4": {
            "Medzuch\\JwtBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medzuch\\JwtBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "phpstan": "Run static analysis at level 9",
        "cs:check": "Check code style without fixing",
        "cs:fix": "Apply code-style fixes",
        "qa": "Fast quality gate (style + phpstan + tests)"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
