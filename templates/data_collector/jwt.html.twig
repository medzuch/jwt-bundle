{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.tokens is not empty %}
        {% set icon %}
            <span class="sf-toolbar-value">JWT</span>
            <span class="sf-toolbar-info-piece-additional-detail">
                <span class="sf-toolbar-status {{ collector.refusals ? 'sf-toolbar-status-red' : '' }}">
                    {{ collector.tokens|length }}
                </span>
            </span>
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Tokens seen</b>
                <span>{{ collector.tokens|length }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Refused</b>
                <span>{{ collector.refusals }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Verifying</b>
                <span>{{ collector.duration|number_format(2) }} ms</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: true }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.refusals ? 'label-status-error' : '' }} {{ collector.tokens is empty ? 'disabled' }}">
        <strong>JWT</strong>
        {% if collector.refusals %}
            <span class="count"><span>{{ collector.refusals }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>JWT</h2>

    {% if collector.tokens is empty %}
        <div class="empty">
            <p>No token was presented to a consumer during this request.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.tokens|length }}</span>
                <span class="label">Tokens seen</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.refusals }}</span>
                <span class="label">Refused</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.duration|number_format(2) }} <span class="unit">ms</span></span>
                <span class="label">Verifying</span>
            </div>
        </div>

        {% for token in collector.tokens %}
            <h3>
                Consumer <code>{{ token.consumer }}</code> —
                {% if token.verdict == 'accepted' %}
                    <span class="label label-status-success">accepted</span>
                {% else %}
                    <span class="label label-status-error">refused: {{ token.reason ?? 'other' }}</span>
                {% endif %}
            </h3>

            <table>
                <tbody>
                    {% if token.verdict == 'accepted' %}
                        <tr><th>Would authenticate as</th><td>{{ token.identity }}</td></tr>
                    {% else %}
                        <tr><th>Why</th><td>{{ token.detail }}</td></tr>
                    {% endif %}
                    <tr><th>Algorithm</th><td>{{ token.alg ?? '(unreadable)' }}</td></tr>
                    <tr><th>Key id</th><td>{{ token.kid ?? '(none named)' }}</td></tr>
                    <tr><th>Took</th><td>{{ token.duration|number_format(2) }} ms</td></tr>
                </tbody>
            </table>

            <h4>Claims, as the token has them</h4>

            {% if token.claims is empty %}
                <div class="empty"><p>Nothing could be decoded: this is not a JWT.</p></div>
            {% else %}
                <table>
                    <thead><tr><th>Claim</th><th>Value</th></tr></thead>
                    <tbody>
                        {% for name, value in token.claims %}
                            <tr>
                                <th>{{ name }}</th>
                                <td>{{ value is iterable ? value|json_encode : value }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endfor %}

        <p class="help">
            The token itself is not collected. Profiler data is written to disk and served back by a
            URL, and a bearer token in there is a credential in a file — one that a screenshot in a
            bug report would carry out of the building. Its <code>jti</code> names it, and the claims
            above say what it said. They are the token's own claims, unverified: a refused token has
            no verified ones, and what it claimed is the point.
        </p>
    {% endif %}
{% endblock %}
