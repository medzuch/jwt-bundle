parameters:
    level: 9
    phpVersion:
        min: 80300
        max: 80400
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    # `service()`, `inline_service()` and the rest are functions, and Composer
    # maps classes. PHPStan finds them only when something else in the run has
    # already loaded the file that declares them, which made the analysis
    # depend on the order `src/` is walked in: the calls used to sit in a file
    # sorted late enough for that to be true. Named here instead, so it is true
    # for whichever file makes them.
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    parallel:
        maximumNumberOfProcesses: 4
    # Off, unlike medzuch/jwt-php, and for a reason that only applies to a
    # package analysed against several framework majors. Symfony 8 annotates
    # `DefinitionConfigurator::rootNode()` with a conditional return type that
    # resolves to ArrayNodeDefinition, while its *native* return type is
    # NodeDefinition on every version — as it still is on 6.4 and 7.4, where
    # narrowing is mandatory to reach `children()`. With this on, the same
    # narrowing is "always true" on one leg and required on the others, and no
    # ignore entry can be right on all four. The library keeps it on; it has
    # one dependency set to satisfy.
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Symfony 8.1 deprecates HttpKernel's `BundleInterface` while its own
        # `KernelInterface::registerBundles()` still documents
        # `@return iterable<BundleInterface>` — so every kernel implementing it
        # inherits the deprecated typehint, including the test kernels here,
        # which name no interface at all. Nothing in this package can fix that;
        # it goes when upstream stops pointing at what it deprecated.
        #
        # `reportUnmatched: false` because the error does not exist on the 6.4
        # and 7.4 legs, where the interface is not deprecated. Which also means
        # the entry goes silent rather than red when it becomes unnecessary, so
        # #51 carries the check that removes it: read
        # `KernelInterface::registerBundles()` when the 8.x leg first resolves
        # Symfony 8.2.
        -
            message: '#has typehint with deprecated interface Symfony\\Component\\HttpKernel\\Bundle\\BundleInterface#'
            path: tests/Functional/App
            reportUnmatched: false

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
